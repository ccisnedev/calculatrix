  {
    "name": "newton_exact",
    "notation": "infix",
    "source": [
      "parameter s",
      "var x = s",
      "var step = 1",
      "while abs(step) > 1e-10",
      "  step = (x^2 - s) / (2*x)",
      "  x = x - step",
      "end",
      "x"
    ],
    "bindings": {
      "s": "2"
    },
    "rpn": ":s parameter s :x variable 1 :step variable { step absolute_value 1e-10 greater } { x 2 power s subtract 2 x multiply divide :step assign x step subtract :x assign } while x",
    "expect": {
      "stack": [
        "886731088897/627013566048"
      ],
      "steps": 101
    }
  },
