  {
    "name": "recursion_factorial",
    "notation": "infix",
    "source": [
      "function fact(n)",
      "  if n <= 1",
      "    1",
      "  else",
      "    n * fact(n - 1)",
      "  end",
      "end",
      "fact(5)"
    ],
    "rpn": "{ :n variable n 1 less_equal { 1 } { n n 1 subtract fact multiply } ifelse } :fact function 5 fact",
    "expect": {
      "stack": [
        "120"
      ],
      "steps": 53
    }
  },
